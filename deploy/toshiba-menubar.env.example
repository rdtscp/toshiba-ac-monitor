# Copy to /home/pi/.toshiba_menubar/server.env on the Pi, fill in, then:
#   chmod 600 /home/pi/.toshiba_menubar/server.env
#   chown pi:pi /home/pi/.toshiba_menubar/server.env
# Read by the systemd unit (EnvironmentFile). NEVER commit the real file.

# Toshiba account login. NOTE: the username is NOT an email.
TOSHIBA_USER=your-toshiba-username
TOSHIBA_PASS=your-toshiba-password

# Bearer token clients must send: "Authorization: Bearer <this>".
# Generate a strong one with:  openssl rand -hex 32
TOSHIBA_API_TOKEN=replace-with-a-long-random-token
