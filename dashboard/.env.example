# Copy to .env.local (gitignored) and fill in. Vite exposes VITE_* to the app.
#
# The microservice base URL (the Pi). Use the mDNS hostname on your LAN:
VITE_API_URL=http://rdtscp-pi.local:8787

# The same bearer token the Pi was given (TOSHIBA_API_TOKEN in server.env).
# NOTE: this is baked into the built JS bundle, so anyone who can load the
# dashboard can read it. That's acceptable for a personal LAN dashboard; don't
# expose the dashboard (or the API) to the internet.
VITE_API_TOKEN=
